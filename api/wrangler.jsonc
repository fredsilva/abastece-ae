{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "abastece-ae-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "observability": {
    "enabled": true
  },
  "vars": {
    // Access Application "Abastece Aê API" (destino abastece-ae-api.fredsilva-sistemas.workers.dev/admin)
    // — ver PLANO-MVP.md, seção "Autenticação — Painel admin".
    "CF_ACCESS_TEAM_DOMAIN": "fredsilva-sistemas.cloudflareaccess.com",
    "CF_ACCESS_AUD": "90967ac15bf2c8679b283af87c43d2e3bf27c599ab7aa023e4a31500b7b82dac"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "abastece-ae-db",
      "database_id": "0e680a18-53f3-4834-a606-bdf95edd851a",
      "migrations_dir": "./migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "1e85590b99d14426bb8577d9b836cbcc"
    }
  ],
  // Serve o build do painel admin (admin/dist) no mesmo domínio do Worker, para o
  // painel e a API ficarem no mesmo host — evita o problema de sessão do Cloudflare
  // Access não valer entre domínios diferentes (pages.dev x workers.dev) em chamadas
  // fetch() feitas em JS. Ver PLANO-MVP.md, seção "Autenticação — Painel admin".
  "assets": {
    "directory": "../admin/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/admin/*",
      "/health",
      "/auth/*",
      "/stations",
      "/stations/*",
      "/price-reports",
      "/price-reports/*",
      "/fill-ups",
      "/fill-ups/*",
      "/ratings",
      "/ratings/*",
      "/favorites",
      "/favorites/*",
      "/push-tokens",
      "/push-tokens/*"
    ]
  }
}
